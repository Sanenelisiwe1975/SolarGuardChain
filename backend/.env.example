# Copy to .env and fill in what you use. Everything optional works when left empty.

# Registry: "local" (hash-chained ledger, no network) or "fuji" (Avalanche testnet)
CHAIN_MODE=local
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
REGISTRY_ADDRESS=
RELAYER_PRIVATE_KEY=

# Salt for anonymous owner IDs. Change it, and never commit .env.
OWNER_SALT=change-me-to-a-long-random-string

# Seconds without a heartbeat before the watchdog acts
HEARTBEAT_TIMEOUT_S=10

# Optional: AI-written alert text (Google AI Studio key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: WhatsApp alerts through the Twilio sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ALERT_WHATSAPP_TO=
